{
  "name": "Esp32Base",
  "version": "0.1.0",
  "description": "ESP32-only Arduino Core base library for application projects.",
  "homepage": "https://github.com/tangyangguang/Esp32Base",
  "repository": {
    "type": "git",
    "url": "https://github.com/tangyangguang/Esp32Base.git"
  },
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
  "build": {
    "includeDir": "src"
  },
  "dependencies": [
    {
      "name": "WiFi",
      "platforms": "espressif32"
    },
    {
      "name": "ESPmDNS",
      "platforms": "espressif32"
    },
    {
      "name": "WebServer",
      "platforms": "espressif32"
    },
    {
      "name": "Update",
      "platforms": "espressif32"
    },
    {
      "name": "LittleFS",
      "platforms": "espressif32"
    }
  ]
}
