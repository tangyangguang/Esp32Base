{
  "name": "Esp32Base",
  "version": "1.0.0",
  "description": "Lightweight ESP32 Arduino Core base library with profile-based trimming.",
  "keywords": ["esp32", "arduino", "base", "wifi", "ota", "littlefs"],
  "homepage": "https://github.com/tangyangguang/Esp32Base",
  "repository": {
    "type": "git",
    "url": "https://github.com/tangyangguang/Esp32Base.git"
  },
  "authors": [
    {
      "name": "Tang Yangguang"
    }
  ],
  "license": "MIT",
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
  "build": {
    "includeDir": "src",
    "srcFilter": [
      "+<*.cpp>",
      "+<core/*.cpp>"
    ]
  },
  "export": {
    "exclude": [
      "design-history",
      "design-history/**",
      "bug-ticklish-kitten.md",
      ".git",
      ".git/**",
      "**/.git",
      "**/.git/**",
      ".claude",
      ".claude/**",
      "**/.claude",
      "**/.claude/**",
      ".piopmignore",
      ".pio",
      ".pio/**",
      ".cache",
      ".cache/**",
      "**/.DS_Store",
      "**/idf_component.yml",
      "**/idf_component.yml.orig"
    ]
  }
}
