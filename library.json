{
  "name": "Esp32Base",
  "version": "1.0.0",
  "description": "Lightweight ESP32 Arduino Core base library with profile-based trimming.",
  "keywords": ["esp32", "arduino", "base", "wifi", "mqtt", "ota", "littlefs"],
  "homepage": "https://github.com/tangyangguang/Esp32Base",
  "repository": {
    "type": "git",
    "url": "https://github.com/tangyangguang/Esp32Base.git"
  },
  "authors": [
    {
      "name": "Tang Yangguang"
    }
  ],
  "license": "MIT",
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
  "build": {
    "includeDir": "src",
    "flags": [
      "-I$PROJECT_PACKAGES_DIR/framework-arduinoespressif32/libraries/AsyncUDP/src",
      "-I$PROJECT_PACKAGES_DIR/framework-arduinoespressif32/libraries/DNSServer/src",
      "-I$PROJECT_PACKAGES_DIR/framework-arduinoespressif32/libraries/ESPmDNS/src",
      "-I$PROJECT_PACKAGES_DIR/framework-arduinoespressif32/libraries/FS/src",
      "-I$PROJECT_PACKAGES_DIR/framework-arduinoespressif32/libraries/Hash/src",
      "-I$PROJECT_PACKAGES_DIR/framework-arduinoespressif32/libraries/LittleFS/src",
      "-I$PROJECT_PACKAGES_DIR/framework-arduinoespressif32/libraries/Network/src",
      "-I$PROJECT_PACKAGES_DIR/framework-arduinoespressif32/libraries/Preferences/src",
      "-I$PROJECT_PACKAGES_DIR/framework-arduinoespressif32/libraries/Update/src",
      "-I$PROJECT_PACKAGES_DIR/framework-arduinoespressif32/libraries/WebServer/src",
      "-I$PROJECT_PACKAGES_DIR/framework-arduinoespressif32/libraries/WiFi/src",
      "-I$PROJECT_PACKAGES_DIR/framework-arduinoespressif32/libraries/Wire/src"
    ],
    "srcFilter": [
      "+<*.cpp>",
      "+<core/*.cpp>",
      "+<web/*.cpp>",
      "+<web/internal/*.cpp>"
    ]
  },
  "export": {
    "exclude": [
      "design-history",
      "design-history/**",
      "bug-ticklish-kitten.md",
      ".git",
      ".git/**",
      "**/.git",
      "**/.git/**",
      ".claude",
      ".claude/**",
      "**/.claude",
      "**/.claude/**",
      ".piopmignore",
      ".pio",
      ".pio/**",
      ".piohome",
      ".piohome/**",
      ".cache",
      ".cache/**",
      "__pycache__",
      "**/__pycache__",
      "**/__pycache__/**",
      "*.py[cod]",
      "**/*.py[cod]",
      "**/.DS_Store",
      "**/idf_component.yml",
      "**/idf_component.yml.orig",
      "local_private",
      "local_private/**",
      "**/local_secrets.h"
    ]
  }
}
